{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "car-detailing-inspect-ai-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Keep the *.workers.dev URL alongside the custom domain.
  "workers_dev": true,
  "routes": [
    { "pattern": "api.car-detailing-inspect-ai.dev", "custom_domain": true }
  ],
  // Per-IP rate limit for POST /api/assess (Workers Rate Limiting, available on the free plan).
  // period must be 10 or 60 seconds. namespace_id is any number unique within your account.
  "ratelimits": [
    {
      "name": "ASSESS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  // Non-secret configuration. Override locally in .dev.vars.
  // Secrets (GEMINI_KEY, TURNSTILE_SECRET) are set with `wrangler secret put`.
  "vars": {
    // Comma-separated list of origins allowed by CORS. Add your production frontend origin here.
    "ALLOWED_ORIGINS": "http://localhost:3000,https://car-detailing-inspect-ai-frontend.disara.workers.dev",
    // Gemini model ID. See README "Changing the Gemini model".
    "GEMINI_MODEL": "gemini-3.8-flash"
  }
}
