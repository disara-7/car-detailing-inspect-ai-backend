# Copy to .dev.vars for local development (`wrangler dev`). Never commit .dev.vars.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_KEY=your-gemini-api-key

# OPTIONAL. Leave unset to disable the Turnstile bot check (the current setup).
# When set, every request must include a valid turnstileToken. Test secret that always passes:
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Comma-separated CORS allow-list
ALLOWED_ORIGINS=http://localhost:3000

# Gemini model ID
GEMINI_MODEL=gemini-3.8-flash
